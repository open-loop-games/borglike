{
  "name": "borglike",
  "private": false,
  "version": "0.1.4",
  "type": "module",
  "description": "Idle/incremental game featuring an auto-playing roguelike",
  "author": "Namahanna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/namahanna/borglike.git"
  },
  "homepage": "https://namahanna.codeberg.page/borglike",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check": "pnpm run format && pnpm run typecheck && pnpm run lint",
    "knip": "knip",
    "diagnose": "tsx --tsconfig tsconfig.scripts.json scripts/diagnose.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@vueuse/core": "^14.1.0",
    "blessed": "^0.1.81",
    "env-paths": "^4.0.0",
    "idb": "^8.0.3",
    "lz-string": "^1.5.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.8",
    "rot-js": "^2.2.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-icons/game-icons": "^1.2.1",
    "@iconify-icons/ph": "^1.2.5",
    "@types/blessed": "^0.1.27",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "knip": "^5.82.1",
    "oxfmt": "^0.72.0",
    "tinypool": "^2.1.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0"
}
